# ============================================================
# ERP Loga - backend/.env (config dev/instalación inicial)
# Valores que funcionan out-of-the-box con install.bat / logaerp.bat.
# Para PRODUCCIÓN regenerar JWT_SECRET, BACKUP_PASSWORD, WEBHOOK_TOKEN
# con valores aleatorios largos.
# ============================================================

DATABASE_URL=postgresql://loga:loga123@localhost:5433/loga_erp
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Secretos (CAMBIAR EN PRODUCCIÓN — generar con: openssl rand -hex 32)
JWT_SECRET=cambiar-en-produccion-jwt-dev-secret-de-al-menos-32-caracteres-largo
BACKUP_PASSWORD=cambiar-en-produccion-backup-pass-de-al-menos-32-caracteres-largo
WEBHOOK_TOKEN=cambiar-en-produccion-webhook-token-aaaaaaaaaaaaaaaaaa

# Auto-heal admin: si entras con admin@loga.es / Admin123! siempre te
# deja entrar y arregla el hash en BD. Cambiar a false en producción.
AUTO_HEAL_ADMIN=true

# Email SMTP (opcional — vacío = no envía emails pero el ERP arranca)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ERP Loga <noreply@example.com>

# Google Drive backup (opcional — vacío = solo backups locales)
DRIVE_API_KEY=
