# Copia a backend/.env y ajusta valores. NO commitear el .env real.

# WINDOWS (instalación con install.bat / logaerp.bat) usa puerto 5433
DATABASE_URL=postgresql://loga:loga123@localhost:5433/loga_erp

# MAC / Linux dev típicamente usa 5432
# DATABASE_URL=postgresql://loga:loga123@localhost:5432/loga_erp

PORT=3001
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Generar con: openssl rand -hex 32
JWT_SECRET=cambia-esto-en-produccion-por-32-chars-aleatorios-aaaaaaaaaaaa
BACKUP_PASSWORD=cambia-esto-en-produccion-por-32-chars-aleatorios-aaaaaaaaa

# Si entras con admin@loga.es / Admin123! y el hash no coincide, te entra
# igual y arregla el hash en BD. En producción real → false.
AUTO_HEAL_ADMIN=true

# SMTP opcional (vacío = no envía emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── INTEGRACIÓN ALILO (otro ERP en la LAN que descuenta stock de Loga) ───
# Vacío = integración deshabilitada (endpoint /api/integracion/alilo/* devuelve 503).
# Generar con: openssl rand -hex 32
# El MISMO valor debe configurarse en el sistema Alilo.
ALILO_SHARED_SECRET=
