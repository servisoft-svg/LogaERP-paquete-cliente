# ============================================================
# ERP Loga — variables de entorno
# Copia este archivo a .env y rellena los valores reales.
# NUNCA committees el .env real.
# ============================================================

# ---- OBLIGATORIAS ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/loga_erp

# Secreto JWT — generar con `openssl rand -hex 32` (mínimo 32 chars)
JWT_SECRET=GENERA_UN_SECRETO_DE_32_CARACTERES_MINIMO_AQUI

# Origen permitido CORS en producción (https://tu-dominio.com)
CORS_ORIGIN=http://localhost:5173

# Password backup AES-256 — mínimo 12 caracteres, generado aleatorio
BACKUP_PASSWORD=GENERA_UN_PASSWORD_FUERTE_DE_BACKUP_AQUI

# ---- OPCIONALES (con defaults seguros) ----
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# ---- SMTP (para emails de proveedor + albaranes) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
# Para Gmail: usar App Password (no la contraseña normal)
SMTP_PASS=tu_app_password_de_16_chars
EMAIL_FROM=ERP Loga <erp@loga.es>

# ---- WEBHOOK (recepción de pedidos por email) ----
# Generar con `openssl rand -hex 24`. Compartir con el script externo.
WEBHOOK_TOKEN=

# ---- BACKUPS (opcional Google Drive vía rclone) ----
# Configurar rclone separadamente: `rclone config` → remote llamado "y"
# Si no hay rclone, los backups solo se guardan localmente.

# ---- BULL/REDIS (opcional, colas para PDFs/emails) ----
# Si no hay Redis, las colas se desactivan y los workers se ejecutan inline.
REDIS_URL=
