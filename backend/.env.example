# RENOMBRA A .env Y CAMBIA LOS VALORES MARCADOS
DATABASE_URL=postgresql://loga:loga123@localhost:5433/loga_erp
PORT=5173
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Generar aleatorios:
#   openssl rand -hex 32  -> JWT_SECRET
#   openssl rand -hex 24  -> BACKUP_PASSWORD
#   openssl rand -hex 16  -> WEBHOOK_TOKEN
JWT_SECRET=CAMBIAR_POR_64_CHARS_HEX
BACKUP_PASSWORD=CAMBIAR_POR_24_CHARS_HEX_ANOTAR_EN_PAPEL
WEBHOOK_TOKEN=CAMBIAR_POR_32_CHARS_HEX

AUTO_HEAL_ADMIN=true
MIGRATIONS_FAIL_SOFT=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
