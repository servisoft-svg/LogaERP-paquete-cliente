# ===========================================
# ERP Loga — Environment Variables
# Copy to .env (dev) or .env.production (prod)
# ===========================================

# Database
POSTGRES_DB=_erp
POSTGRES_USER=
POSTGRES_PASSWORD=          # REQUIRED: Strong random password
DATABASE_URL=postgresql://loga:PASSWORD@localhost:5432/loga_erp

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Auth — REQUIRED: Generate with: openssl rand -base64 48
JWT_SECRET=

# Backups — REQUIRED: Strong random password
BACKUP_PASSWORD=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ERP Loga <noreply@example.com>

# Google Drive (optional)
DRIVE_API_KEY=

# Redis (optional — app works without it)
REDIS_URL=redis://localhost:6379

# Webhook (optional)
WEBHOOK_TOKEN=
