FROM node:20-alpine AS build

WORKDIR /app

COPY frontend/package*.json ./
# npm ci reproducible (requiere package-lock.json sincronizado)
RUN npm ci --no-audit --no-fund

COPY frontend/ ./
RUN npm run build

# ── Runtime nginx (no root) ───────────────────────────────────
FROM nginx:alpine

# Healthcheck necesita wget
RUN apk add --no-cache wget

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# nginx:alpine ya tiene usuario `nginx`. Le damos permisos sobre los
# directorios que necesita escribir (cache, pid, logs).
RUN chown -R nginx:nginx /var/cache/nginx /var/run /var/log/nginx \
 && touch /var/run/nginx.pid \
 && chown nginx:nginx /var/run/nginx.pid

# nginx oficial corre como root para bind en :80; nginx.conf ya define
# listen 8080 (ver nginx.conf). docker-compose mapea host:80 → container:8080.
USER nginx

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/ >/dev/null 2>&1 || exit 1
